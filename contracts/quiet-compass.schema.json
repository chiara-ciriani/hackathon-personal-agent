{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiet-compass.local/contracts/quiet-compass.schema.json",
  "title": "Quiet Compass shared contracts",
  "description": "Single source of truth for data exchanged between the iOS app and the memory service. Version 1. Change only by agreement of all tracks; bump `contract_version` on breaking changes.",
  "$defs": {
    "ContractVersion": { "const": 1 },
    "Uuid": { "type": "string", "format": "uuid" },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 in UTC with a Z suffix, e.g. 2026-10-24T20:15:03.120Z"
    },
    "CaptureMode": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "A = FOA + ARKit, B = FOA + labelled zones, C = ARKit + mono levels"
    },
    "TrackingState": {
      "type": "string",
      "enum": ["normal", "limited", "not_available", "none"],
      "description": "ARKit tracking state at measurement time; `none` in mode B (no AR session)"
    },
    "Goal": { "type": "string", "enum": ["talk", "rest", "work"] },
    "Verdict": { "type": "string", "enum": ["good", "ok", "bad"] },
    "Feel": { "type": "string", "enum": ["calm", "neutral", "chaotic"] },
    "PlaceTag": { "type": "string", "enum": ["seating", "step_free", "authorized"] },
    "Position": {
      "type": "object",
      "description": "Floor-plane position in metres in the AR session's world frame (gravity-aligned, arbitrary yaw). y is omitted on purpose.",
      "required": ["x", "z"],
      "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "z": { "type": "number" } }
    },
    "DeviceProfile": {
      "type": "object",
      "required": ["model", "os_version", "capture_mode", "audio_session_mode", "sample_rate_hz", "app_version"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "examples": ["iPhone17,1"] },
        "os_version": { "type": "string", "examples": ["26.1"] },
        "capture_mode": { "$ref": "#/$defs/CaptureMode" },
        "audio_session_mode": { "type": "string", "examples": ["measurement", "default"] },
        "sample_rate_hz": { "type": "integer", "examples": [48000] },
        "app_version": { "type": "string" }
      }
    },
    "Session": {
      "type": "object",
      "required": ["id", "started_at", "device_profile"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": ["string", "null"], "examples": ["SF hackathon, main hall"] },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "device_profile": { "$ref": "#/$defs/DeviceProfile" }
      }
    },
    "SoundClass": {
      "type": "object",
      "required": ["label", "confidence"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "examples": ["speech", "music", "crowd"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "DirectionEstimate": {
      "type": "object",
      "description": "Direction of arrival of the dominant coherent sound. Only present when the estimator did not abstain.",
      "required": ["frame", "azimuth_deg", "sector", "confidence"],
      "additionalProperties": false,
      "properties": {
        "frame": { "type": "string", "enum": ["world", "device"], "description": "world in mode A (rotated with the ARKit pose), device in mode B" },
        "azimuth_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        "elevation_deg": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "sector": { "type": "integer", "minimum": 0, "maximum": 7, "description": "0 = ahead (−22.5°..22.5°), counting clockwise in 45° steps" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "1 − diffuseness, after gating" }
      }
    },
    "Observation": {
      "type": "object",
      "description": "A 5-second aggregate of 1 s feature frames. All levels are relative, uncalibrated dBFS from one device profile; never dBA or SPL.",
      "required": ["id", "session_id", "t", "duration_s", "level_dbfs_rel", "spread_db", "peaks_per_min", "tracking"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid", "description": "Client-generated; the server ignores duplicates (idempotent retries)" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "t": { "$ref": "#/$defs/Timestamp", "description": "End of the 5 s window" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "position": { "oneOf": [{ "$ref": "#/$defs/Position" }, { "type": "null" }] },
        "crumb_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "place_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }], "description": "Set while the user is within 2 m of a marked place, or inside a labelled zone" },
        "level_dbfs_rel": { "type": "number", "maximum": 0 },
        "level_aw_dbfs_rel": { "type": ["number", "null"], "maximum": 0 },
        "spread_db": { "type": "number", "minimum": 0, "description": "L10 − L90 of 125 ms frames over a rolling 30 s" },
        "peaks_per_min": { "type": "number", "minimum": 0, "description": "125 ms frames above rolling median + 10 dB, per minute, rolling 60 s" },
        "bands_db": {
          "type": ["array", "null"],
          "description": "Octave bands centred 250, 500, 1k, 2k, 4k, 8k Hz, relative dBFS",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        },
        "speech_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Mean `speech` confidence from the built-in sound classifier" },
        "classes": { "type": "array", "items": { "$ref": "#/$defs/SoundClass" }, "maxItems": 3 },
        "doa": { "oneOf": [{ "$ref": "#/$defs/DirectionEstimate" }, { "type": "null" }] },
        "tracking": { "$ref": "#/$defs/TrackingState" }
      }
    },
    "Crumb": {
      "type": "object",
      "required": ["id", "session_id", "seq", "position", "heading_rad", "t", "tracking"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "seq": { "type": "integer", "minimum": 0, "description": "Monotonic within a session; a gap in tracking starts a new segment" },
        "segment": { "type": "integer", "minimum": 0, "default": 0 },
        "position": { "$ref": "#/$defs/Position" },
        "heading_rad": { "type": "number" },
        "t": { "$ref": "#/$defs/Timestamp" },
        "tracking": { "$ref": "#/$defs/TrackingState" }
      }
    },
    "Place": {
      "type": "object",
      "required": ["id", "session_id", "label", "created_at", "source", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80, "examples": ["Quiet corner by the windows"] },
        "position": { "oneOf": [{ "$ref": "#/$defs/Position" }, { "type": "null" }], "description": "Null in mode B (zone only)" },
        "crumb_id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
        "zone": { "type": ["string", "null"], "description": "User-given zone name in mode B" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/PlaceTag" }, "uniqueItems": true },
        "source": { "type": "string", "enum": ["user", "organizer", "seed"] },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Feedback": {
      "type": "object",
      "required": ["id", "session_id", "place_id", "goal", "verdict", "t"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "session_id": { "$ref": "#/$defs/Uuid" },
        "place_id": { "$ref": "#/$defs/Uuid" },
        "goal": { "$ref": "#/$defs/Goal" },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "feel": { "oneOf": [{ "$ref": "#/$defs/Feel" }, { "type": "null" }] },
        "t": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Guidance": {
      "type": "object",
      "description": "Written by the agent tool quiet_start_guidance; polled by the phone, which computes the route itself from its own breadcrumbs.",
      "required": ["session_id", "target_place_id", "target_label", "status", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "$ref": "#/$defs/Uuid" },
        "target_place_id": { "$ref": "#/$defs/Uuid" },
        "target_label": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "arrived", "cancelled"] },
        "reason": { "type": ["string", "null"], "description": "Short agent explanation shown on the phone, e.g. 'Quietest spot you measured 4 min ago'" },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "SessionUpsert": {
      "type": "object",
      "required": ["contract_version", "session"],
      "additionalProperties": false,
      "properties": { "contract_version": { "$ref": "#/$defs/ContractVersion" }, "session": { "$ref": "#/$defs/Session" } }
    },
    "ObservationBatch": {
      "type": "object",
      "required": ["contract_version", "observations"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/Observation" }, "maxItems": 500 }
      }
    },
    "CrumbBatch": {
      "type": "object",
      "required": ["contract_version", "crumbs"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "crumbs": { "type": "array", "items": { "$ref": "#/$defs/Crumb" }, "maxItems": 2000 }
      }
    },
    "PlaceBatch": {
      "type": "object",
      "required": ["contract_version", "places"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "places": { "type": "array", "items": { "$ref": "#/$defs/Place" }, "maxItems": 200 }
      }
    },
    "FeedbackBatch": {
      "type": "object",
      "required": ["contract_version", "feedback"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "feedback": { "type": "array", "items": { "$ref": "#/$defs/Feedback" }, "maxItems": 200 }
      }
    },
    "GuidanceStatusUpdate": {
      "type": "object",
      "description": "Sent by the phone to mark guidance as arrived or cancelled.",
      "required": ["contract_version", "status"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "status": { "type": "string", "enum": ["arrived", "cancelled"] }
      }
    },
    "IngestResult": {
      "type": "object",
      "required": ["accepted", "duplicates"],
      "additionalProperties": false,
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 }
      }
    },
    "EvidenceLabel": {
      "type": "string",
      "enum": ["measured", "measured_crowdsourced", "reference_measured", "proxy", "unmeasured_candidate"],
      "description": "What a city-layer record is. measured = sensor measurement (SFO monitors only: CNEL and aircraft exceedance events); measured_crowdsourced = uncalibrated phone measurements from NoiseCapture volunteers (ODbL), aggregated into ~100 m cells; reference_measured = published measurement with a citation; proxy = permit, closure or complaint/dispatch count that hints at possible noise; unmeasured_candidate = place from a city inventory that nobody has measured. The web map shows no synthetic scores; its violet field is a density of real reports (a count, not dB) and is never served as a measurement. Only the separate /venue page is a labelled demo."
    },
    "LayerPoint": {
      "type": "object",
      "description": "One record of the SF city layers (MCP quiet_sf_layers). Never a phone reading: dB values here are CNEL or event levels from SFO monitors, or crowdsourced LAeq, and none is comparable with level_dbfs_rel.",
      "required": ["layer", "kind", "label", "lat", "lon", "evidence", "caveat", "dataset"],
      "additionalProperties": false,
      "properties": {
        "layer": { "type": "string", "enum": ["quiet_candidates", "entertainment_permits", "night_noise_permits", "street_closures", "sfo_cnel", "sfo_events", "cad_noise_calls", "noisecapture"] },
        "kind": { "type": "string", "examples": ["popos", "library", "park", "entertainment_permit", "sfo_monitor", "sfo_exceedance_events", "noise_nuisance_calls", "noisecapture_cell"] },
        "label": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "evidence": { "enum": ["measured", "measured_crowdsourced", "proxy", "unmeasured_candidate"] },
        "caveat": { "type": "string" },
        "dataset": { "type": "string", "description": "DataSF dataset id (noisecapture: the Noise-Planet dump)", "examples": ["65ik-7wqd", "tiju-qyvs"] },
        "source": { "const": "seed", "description": "Present only on unmeasured candidates, mirroring Place.source = seed" },
        "detail": { "type": "string" },
        "cnel_db": { "type": "number", "description": "Daily CNEL (A-weighted dB, 24 h) at the monitor. Only on evidence = measured" },
        "observed_on": { "type": "string", "format": "date" },
        "distance_m": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0, "description": "sfo_events: exceedance events in the last 365 days; cad_noise_calls: NOISE NUISANCE dispatches in the last 30 days at the masked intersection; noisecapture: independent 5-minute windows in the cell" },
        "max_level_db": { "type": "number", "description": "sfo_events only: loudest event, dBA (source field max_level is text). Always read with observed_on" },
        "median_level_db": { "type": "number", "description": "sfo_events: median of event max levels, dBA; noisecapture: median 5-minute LAeq of the cell, dB (uncalibrated)" },
        "laeq_db": { "type": "number", "description": "noisecapture only: energy-mean LAeq of the cell's 5-minute windows, dB (uncalibrated, outlier-sensitive)" },
        "quality": { "const": "measured_crowdsourced_uncalibrated", "description": "noisecapture only" }
      }
    },
    "ReferenceLevel": {
      "type": "object",
      "description": "A published measured level with its citation. Context only: old, area-specific, not comparable to phone dBFS.",
      "required": ["id", "area", "location", "level_dba_ldn", "duration", "measured_on", "source", "source_url", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "area": { "type": "string" },
        "location": { "type": "string" },
        "level_dba_ldn": { "type": "integer" },
        "duration": { "type": "string" },
        "measured_on": { "type": "string", "format": "date" },
        "source": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "evidence": { "const": "reference_measured" }
      }
    },
    "SfLayersResult": {
      "type": "object",
      "required": ["lat", "lon", "radius_m", "layers", "note"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "radius_m": { "type": "integer", "minimum": 50, "maximum": 2000 },
        "layers": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/LayerPoint" } } },
        "unavailable": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Layers whose dataset could not be fetched; treat as unknown" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/ReferenceLevel" } },
        "reference_note": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "AreaId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._,-]{0,119}$",
      "description": "Coarse place id: an organizer's indoor zone (e.g. demo-venue-courtyard) or an outdoor cell `cell:<lat>,<lon>` with 3 decimals (~100 m).",
      "examples": ["demo-venue-courtyard", "cell:37.770,-122.420"]
    },
    "AreaKind": { "type": "string", "enum": ["indoor_zone", "outdoor_cell"] },
    "SharedContribution": {
      "type": "object",
      "description": "Shared sound layer v0.1. One consented acoustic summary. No audio, transcript, route, identity, preference or health data. The server re-rounds lat/lon to 3 decimals and floors time_bucket to 5 minutes UTC.",
      "required": ["id", "schema_version", "area_id", "time_bucket", "duration_seconds", "measurement", "quality", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid", "description": "Client-generated; resending the same id is idempotent." },
        "schema_version": { "const": "0.1" },
        "area_id": { "$ref": "#/$defs/AreaId" },
        "area_name": { "type": ["string", "null"], "maxLength": 80 },
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90, "description": "Rounded to 3 decimals. Give lat and lon together or neither." },
        "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "time_bucket": { "$ref": "#/$defs/Timestamp", "description": "Start of a 5-minute UTC bucket." },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "description": "The server rejects values outside 5-600." },
        "measurement": {
          "type": "object",
          "required": ["kind", "rms_dbfs", "frame_level_spread_db", "calibrated"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "relative_uncalibrated" },
            "rms_dbfs": { "type": "number", "maximum": 0, "description": "Relative dBFS, never dBA. The server rejects values below -120." },
            "frame_level_spread_db": { "type": "number", "minimum": 0, "description": "The server rejects values above 60." },
            "peaks_per_min": { "type": ["number", "null"], "minimum": 0 },
            "calibrated": { "const": false }
          }
        },
        "quality": {
          "type": "object",
          "required": ["capture_profile", "clipping_detected"],
          "additionalProperties": false,
          "properties": {
            "capture_profile": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Device + capture configuration cohort. Levels are only compared within one profile." },
            "clipping_detected": { "type": "boolean" }
          }
        },
        "source": { "type": "string", "enum": ["device", "synthetic_demo"] }
      }
    },
    "ContributionUpload": {
      "type": "object",
      "required": ["contract_version", "contribution"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "contribution": { "$ref": "#/$defs/SharedContribution" }
      }
    },
    "ContributionResult": {
      "type": "object",
      "required": ["status", "reason", "area_id", "time_bucket"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["accepted", "withheld", "rejected"], "description": "accepted: stored and its aggregate is released; withheld: stored, cohort below the release threshold; rejected: not stored." },
        "reason": { "type": ["string", "null"] },
        "area_id": { "type": "string", "description": "The area the server assigned (e.g. the outdoor cell)." },
        "time_bucket": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AreaUpsert": {
      "type": "object",
      "description": "Body of PUT /v1/areas/{area_id}.",
      "required": ["lat", "lon", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 80 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "kind": { "$ref": "#/$defs/AreaKind" }
      }
    },
    "Area": {
      "type": "object",
      "required": ["id", "name", "lat", "lon", "kind", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/AreaId" },
        "name": { "type": ["string", "null"] },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "kind": { "$ref": "#/$defs/AreaKind" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AreaAggregate": {
      "type": "object",
      "description": "A released (area, time_bucket, capture_profile) cohort. Different capture profiles are never merged.",
      "required": ["area_id", "area_name", "lat", "lon", "area_kind", "distance_m", "time_bucket", "capture_profile", "n", "measurement_kind", "median_rms_dbfs", "median_frame_level_spread_db", "median_peaks_per_min", "clipped_count", "age_minutes", "has_synthetic", "source", "coverage"],
      "additionalProperties": false,
      "properties": {
        "area_id": { "type": "string" },
        "area_name": { "type": ["string", "null"] },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "area_kind": { "$ref": "#/$defs/AreaKind" },
        "distance_m": { "type": "number", "minimum": 0, "description": "Straight-line distance from the query point." },
        "time_bucket": { "$ref": "#/$defs/Timestamp" },
        "capture_profile": { "type": "string" },
        "n": { "type": "integer", "minimum": 1 },
        "measurement_kind": { "const": "relative_uncalibrated" },
        "median_rms_dbfs": { "type": "number" },
        "median_frame_level_spread_db": { "type": "number" },
        "median_peaks_per_min": { "type": ["number", "null"] },
        "clipped_count": { "type": "integer", "minimum": 0 },
        "age_minutes": { "type": "number", "minimum": 0 },
        "has_synthetic": { "type": "boolean" },
        "source": { "type": "string", "enum": ["device", "synthetic_demo", "mixed"] },
        "coverage": { "type": "string" }
      }
    },
    "SoundMapResponse": {
      "type": "object",
      "description": "GET /v1/map/aggregates and the query_sound_map tool.",
      "required": ["generated_at", "lat", "lon", "radius_m", "since_minutes", "release_min_contributions", "aggregates", "unknown_coverage"],
      "additionalProperties": false,
      "properties": {
        "generated_at": { "$ref": "#/$defs/Timestamp" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "radius_m": { "type": "integer" },
        "since_minutes": { "type": "integer" },
        "release_min_contributions": { "type": "integer", "minimum": 1 },
        "aggregates": { "type": "array", "items": { "$ref": "#/$defs/AreaAggregate" } },
        "unknown_coverage": { "type": "string" }
      }
    }
  }
}
