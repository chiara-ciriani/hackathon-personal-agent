# Local development only. Replace before starting the service.
QC_API_TOKEN=replace-with-a-long-random-token
# Separate shared-only access for external agents. Generate a different random value.
# Omit to disable /mcp/shared. Never distribute QC_API_TOKEN to external agents.
# QC_SHARED_API_TOKEN=
QC_DB_PATH=./data/quiet_compass.db
QC_ALLOWED_HOSTS=localhost,127.0.0.1
QC_CITY_LAYER_ENABLED=false

# Set this to the recording session's UUID before an agent test.
# If unset, the current implementation selects the most recently updated session.
# QC_ACTIVE_SESSION_ID=

# Optional token for the public SF 311 data source.
# QC_SOCRATA_APP_TOKEN=

# Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# For a custom domain, append that exact hostname to QC_ALLOWED_HOSTS.

# Wearables: private storage uses a separate, persistent 32-byte key.
# Generate locally: python -c 'import secrets; print(secrets.token_hex(32))'
# Never rotate this key without migrating existing encrypted records.
# QC_ENCRYPTION_KEY=

# Register this server-side callback in your Oura developer app:
# https://YOUR-SERVER/oauth/oura/callback
# Render supplies RENDER_EXTERNAL_URL; set QC_PUBLIC_URL for other hosts.
# QC_PUBLIC_URL=https://YOUR-SERVER
# QC_OURA_CLIENT_ID=
# QC_OURA_CLIENT_SECRET=
# Shared sound layer. Set the release threshold to 1 only for a single-phone test.
# QC_RELEASE_MIN_CONTRIBUTIONS=2
# QC_CONTRIBUTION_RETENTION_HOURS=24
# Origins allowed to read GET /v1/map/aggregates from a browser (comma-separated).
# QC_MAP_ALLOWED_ORIGINS=*

# The WEB APP runtime also needs QC_SERVER_URL=https://YOUR-SERVER for its MCP panel.
# Do not put API keys in NEXT_PUBLIC_* variables.
# Serve the active session's sound field to the venue page without a token (reveals the walked path).
# QC_PUBLIC_VENUE_FIELD=0
